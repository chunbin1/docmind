PORT=3001
CHROMA_URL=http://localhost:8000

# --- Auth (GitHub OAuth login + per-user message quota) ---
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               https://docmind.cbsama.uk
#   Authorization callback URL:  https://docmind.cbsama.uk/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of the app (no trailing slash). Drives the OAuth callback,
# post-login redirect, and whether the session cookie is `secure`.
APP_URL=https://docmind.cbsama.uk
# Secret used to sign the session cookie. Set a long random value so logins
# survive restarts:  openssl rand -hex 32
COOKIE_SECRET=
# Per-user message cap before requiring the `unlimited` DB flag (default 10).
# MESSAGE_LIMIT=10
# Local dev only: set to true to skip login entirely (acts as an unlimited user).
# AUTH_DISABLED=true

# LLM Provider: "anthropic" | "zhipu" (auto-detected if omitted)
# LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Zhipu AI
# ZHIPU_API_KEY=your-zhipu-key-here
# ZHIPU_MODEL=glm-4.6v-flashx,glm-4.7,glm-4.6v,glm-4.5-air
# Comma-separated list — tried in order, falls back to next on quota exhaustion.

# Debug: log exactly what is sent to the LLM (system prompt + messages + tools).
# Covers chat/compact/nudge/tool-preflight and all eval calls. Off by default.
#   LOG_LLM=1     — log requests, long fields truncated (~1500 chars)
#   LOG_LLM=full  — log requests in full, no truncation
# LOG_LLM=1

# Retrieval strategy: distance threshold + dynamic k (replaces fixed top-k).
# Returns a variable number of chunks based on actual cosine distance.
# RAG_DISTANCE_THRESHOLD=0.5   # keep chunks with cosine distance <= this (smaller = more similar, ~0..1)
# RAG_MIN_K=1                  # floor: always return at least this many (set 0 to allow "no match → refuse")
# RAG_MAX_K=5                  # cap: at most this many chunks

# Debug: log retrieval candidates with their cosine distances + threshold filtering. Off by default.
# LOG_RETRIEVAL=1

# Observability: per-request tracing into SQLite (traces / trace_spans tables),
# queryable by admins at GET /api/traces. On by default.
#   TRACING=off          — disable tracing entirely (zero overhead)
#   TRACE_CONTENT=off    — store span metadata only, no truncated message/memory text
# TRACING=off
# TRACE_CONTENT=off
